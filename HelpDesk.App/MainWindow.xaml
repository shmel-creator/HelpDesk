<Window x:Class="HelpDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Учёт заявок" Height="560" Width="920">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель создания новой заявки (ровная сетка 2x4) -->
        <GroupBox Header="Новая заявка" Grid.Row="0" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Первая строка -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Оборудование:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="equipmentBox" DisplayMemberPath="Name" Height="26" Margin="0,0,16,0"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Приоритет:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="priorityBox" Height="26" Margin="0,0,16,0"/>

                <!-- Вторая строка -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Заголовок:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="titleBox" Height="26" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="Описание:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="2" Grid.Column="3" x:Name="descriptionBox" Height="26" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="4" Content="Создать" Width="105" Height="60" Click="OnCreateTicketClick"/>
            </Grid>
        </GroupBox>

        <!-- Таблица заявок -->
        <DataGrid x:Name="ticketsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="90"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Создана (UTC)" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                <DataGridTextColumn Header="Дедлайн SLA" Binding="{Binding SlaDeadline, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                <DataGridCheckBoxColumn Header="Просрочена" Binding="{Binding IsOverdue}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Нижняя панель смены статуса и обновления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Новый статус для выбранной заявки:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="statusBox" Width="140" Height="26" Margin="0,0,8,0"/>
            <Button Content="Изменить статус" Width="130" Height="26" Margin="0,0,16,0" Click="OnChangeStatusClick"/>
            <Button Content="Обновить список" Width="130" Height="26" Click="OnRefreshClick"/>
        </StackPanel>
    </Grid>
</Window>